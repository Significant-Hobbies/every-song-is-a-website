{
  "name": "every-song-is-a-website",
  "main": "tools/agent-worker.mjs",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "music.significanthobbies.com", "custom_domain": true }
  ]
}
